{
  "name": "dsh-bili-base",
  "version": "0.5.6",
  "description": "B站 能力底座插件（纯 JS、零运行时依赖）：登录与凭证、昵称↔UID、一条带 Cookie/CSRF/WBI 签名的通用 API 通道、取画面帧、JSONL 记账；六项能力（搜索筛选 / 看画面 / 评论 / 读私信 / 写私信 / 记账）以 SKILL.md 形式按需加载，常驻工具声明只有 4 只。与 c1overzz/dsh-bili-scroll 并存，不抢它的值班轮与家目录。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./skills/*.md": "./skills/*.md",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "ecbob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecbob/dsh-bili-base.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bilibili",
    "base",
    "skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "gaia"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check scripts/selftest.mjs",
    "test": "npm run check && node scripts/selftest.mjs",
    "pack": "npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2"
    }
  }
}
